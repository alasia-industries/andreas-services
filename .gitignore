node_modules/
**/node_modules/
.react-router/
**/.react-router/
package-lock.json
**/package-lock.json
!design-system/package-lock.json
!website/frontend/package-lock.json
!classroom/frontend/package-lock.json

# TypeScript incremental build state — a local artifact, never committed.
*.tsbuildinfo

# .NET artifacts
**/bin/
**/obj/
*.user
*.suo

# The generic Python "lib/" rule above unintentionally matches real TS source
# directories (not Python venv dirs), so re-include them explicitly.
!website/frontend/app/lib/
!website/frontend/app/lib/**

# Terraform
*.tfvars
!*.tfvars.example
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup

# Claude Code worktrees
.claude/worktrees/

# Agent skills — machine-local tooling installed by scripts/dev-setup.sh, never
# committed. The real SKILL.md files live in .agents/skills/; the entries under
# .claude/skills/ are symlinks into them, which is how Claude Code discovers
# them. Both are generated, so both are ignored — except the skills this repo
# authors itself, allowlisted one by one below.
.agents/
skills-lock.json
.claude/skills/*
!.claude/skills/design-system-ui/
!.claude/skills/aws-naming/
!.claude/skills/github-access/

# Local scratch space — never git.
tmp/

# Terraform packages Lambda zips at plan time; build artifacts, not source.
.terraform-build/
