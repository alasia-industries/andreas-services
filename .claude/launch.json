{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "classroom",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": [
        "-c",
        "unset PORT; exec ./classroom/scripts/dev-up.sh"
      ],
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "website",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "exec ./website/scripts/dev-up.sh --frontend"
      ],
      "port": 5175,
      "autoPort": false
    },
    {
      "name": "website-backend",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "exec ./website/scripts/dev-up.sh --backend"
      ],
      "port": 8002,
      "autoPort": false
    },
    {
      "name": "website-prod",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "exec ./website/scripts/dev-up.sh --serve-build"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}
