{
  "name": "humbugg-mcp-widgets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The MCP Apps pages humbugg-mcp serves, built from React and @ansavva/design-system into single HTML files under ../humbugg_mcp/ui/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node build.mjs && node e2e/build-host.mjs && playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ansavva/design-system": "0.21.9",
    "@fontsource/open-sans": "^5.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
