# Humbugg local development — the one file, and this is what it looks like.
# Readers: Docker Compose takes the whole file as env_file for the backend;
# dev-up-app.sh exports only EXPO_PUBLIC_*; dev-up-marketing.sh only VITE_*;
# the integration and e2e tiers parse it. Not committed; outside the repo so it
# survives git clean and is shared by every worktree on the machine.
# Written by dev-aws-setup.sh; the real file is ~/.config/andreas-services/humbugg/dev.env.

# ---- generated (rewritten on every dev-aws-setup.sh run; do not hand-edit) ----

# AWS
AWS_PROFILE=default
AWS_DEFAULT_REGION=us-east-1

# Cognito — the SHARED dev pool (infra/envs/dev-shared), one for every machine.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_CLIENT_ID=example
# The MCP hosts' clients (comma-separated), accepted beside the app client.
COGNITO_ADDITIONAL_CLIENT_IDS=example-mcp-claude,example-mcp-smoke

# Storage. Empty endpoints mean real AWS, not a local emulator.
DYNAMODB_ENDPOINT_URL=
S3_ENDPOINT_URL=
HUMBUGG_APP_BUCKET=humbugg-dev-000000000000-000000000000-app
HUMBUGG_AVATAR_BASE_URL=https://humbugg-dev-000000000000-000000000000-app.s3.us-east-1.amazonaws.com
HUMBUGG_AVATAR_PRESIGNED_READS=true

# This machine's name to Stripe. The backend stamps it into every Checkout; the
# webhook consumer forwards only events that carry it. Per machine on purpose.
HUMBUGG_ENVIRONMENT=dev-000000000000

# Stripe webhook relay — this machine's public endpoint (registered with Stripe by
# dev-aws-setup.sh) and the queue behind it, which the consumer dev-up.sh starts drains into :5001.
HUMBUGG_WEBHOOK_ENDPOINT_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/stripe/webhook
HUMBUGG_WEBHOOK_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/humbugg-dev-000000000000-stripe-webhooks

# DynamoDB tables — all twelve required; the backend refuses to start without any one.
HUMBUGG_PROFILES_TABLE=humbugg-dev-000000000000-profiles
HUMBUGG_GROUPS_TABLE=humbugg-dev-000000000000-groups
HUMBUGG_GROUPMEMBERS_TABLE=humbugg-dev-000000000000-groupmembers
HUMBUGG_WISHES_TABLE=humbugg-dev-000000000000-wishes
HUMBUGG_DRAWS_TABLE=humbugg-dev-000000000000-draws
HUMBUGG_AUDIT_EVENTS_TABLE=humbugg-dev-000000000000-audit-events
HUMBUGG_ANALYTICS_EVENTS_TABLE=humbugg-dev-000000000000-analytics-events
HUMBUGG_EMAIL_MESSAGES_TABLE=humbugg-dev-000000000000-email-messages
HUMBUGG_BILLING_TABLE=humbugg-dev-000000000000-billing
HUMBUGG_INVITATIONS_TABLE=humbugg-dev-000000000000-invitations
HUMBUGG_REMINDERS_TABLE=humbugg-dev-000000000000-reminders
HUMBUGG_TEMPLATES_TABLE=humbugg-dev-000000000000-templates
HUMBUGG_QUESTIONS_TABLE=humbugg-dev-000000000000-questions

# Product app (Metro inlines EXPO_PUBLIC_*; dev-up-app.sh exports only this prefix).
# The domain is the Managed Login HOST — no scheme, no path — the shared dev
# pool's default Cognito domain, the same on every machine.
EXPO_PUBLIC_COGNITO_CLIENT_ID=example
EXPO_PUBLIC_COGNITO_DOMAIN=humbugg-dev.auth.us-east-1.amazoncognito.com
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/api
# The realtime channel (#691): the dev container's own socket. Production is wss://ws.humbugg.com.
EXPO_PUBLIC_REALTIME_URL=ws://127.0.0.1:5001/ws
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:5176

# Marketing site (Vite inlines VITE_*; dev-up-marketing.sh exports only this prefix).
VITE_APP_BASE_URL=http://localhost:5176
VITE_APP_ORIGIN=http://localhost:8081
VITE_API_BASE_URL=http://127.0.0.1:5001

# ---- yours (kept as-is across reruns) -----------------------------------------

# Dev test account — dev-user.sh writes both. The address is one of the people in
# seeds/dev.json (all .test); the password is shared by every account dev-aws-seed.sh creates.
HUMBUGG_DEV_USER_EMAIL=dev@humbugg.test
HUMBUGG_DEV_USER_PASSWORD=

# Plans. Unset means the backend defaults (6 / 50 / 10000, $12 / $99).
# Lower HUMBUGG_FREE_PARTICIPANT_LIMIT to hit the Free cap with fewer accounts.
#HUMBUGG_FREE_PARTICIPANT_LIMIT=
#HUMBUGG_PLUS_PARTICIPANT_LIMIT=
#HUMBUGG_WORK_PARTICIPANT_LIMIT=
#HUMBUGG_PLUS_PRICE_CENTS=
#HUMBUGG_WORK_PRICE_CENTS=
HUMBUGG_WORK_ENABLED=false

# Stripe, TEST MODE ONLY (live is blocked, #159). 'disabled' runs without Stripe.
# Keys from the humbugg-dev sandbox; docs/stripe-setup.md. Once HUMBUGG_STRIPE_MODE=test
# and the secret key are set, re-run dev-aws-setup.sh: it registers this machine's
# webhook endpoint with Stripe and writes the endpoint id and its whsec_ below.
HUMBUGG_STRIPE_MODE=disabled
#HUMBUGG_PLUS_PRODUCT_ID=
#HUMBUGG_PLUS_PRICE_ID=
#HUMBUGG_WORK_PRODUCT_ID=
#HUMBUGG_WORK_PRICE_ID=
#HUMBUGG_STRIPE_PUBLISHABLE_KEY=
#HUMBUGG_STRIPE_SECRET_KEY=
#HUMBUGG_STRIPE_WEBHOOK_ENDPOINT_ID=
#HUMBUGG_STRIPE_WEBHOOK_SECRET=

# Social sign-in on the SHARED dev pool. Keys from the team password manager; a
# machine that has them applies them for everyone on its next dev-aws-setup.sh run,
# and one that lacks them for a provider the pool already has is refused (--skip-shared
# to use the pool untouched). docs/auth-social-login.md. Providers on the pool now: none.
# Dev redirect URI, every machine: https://humbugg-dev.auth.us-east-1.amazoncognito.com/oauth2/idpresponse
#HUMBUGG_GOOGLE_CLIENT_ID=
#HUMBUGG_GOOGLE_CLIENT_SECRET=
#HUMBUGG_FACEBOOK_APP_ID=
#HUMBUGG_FACEBOOK_APP_SECRET=
#HUMBUGG_APPLE_SERVICES_ID=
#HUMBUGG_APPLE_TEAM_ID=
#HUMBUGG_APPLE_KEY_ID=
# base64 of the .p8 file, one line: `base64 -i AuthKey_XXXX.p8 | tr -d '\n'`.
#HUMBUGG_APPLE_PRIVATE_KEY_BASE64=
#HUMBUGG_LINKEDIN_CLIENT_ID=
#HUMBUGG_LINKEDIN_CLIENT_SECRET=
